# ─── Credentials (ห้าม commit เด็ดขาด) ───────────────
.env
*.json
!package.json
!vercel.json
# config ของแอป (ไม่มี secret — ตรวจก่อน commit ทุกครั้ง)
!backend/config/*.json
gee-key.json
service-account*.json

# ─── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ─── IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────
*.log
logs/

# ─── DB backups (มีข้อมูลส่วนบุคคล ห้ามขึ้น git) ──────
backups/

# ─── สคริปต์ seed ที่เคยมี key จริง (ใช้ในเครื่องเท่านั้น) ──
backend/seed_nayaiam.py

# ─── ไฟล์สถานะเครื่องมือในเครื่อง ──
**/.claude/

