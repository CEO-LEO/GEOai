# ─── LINE ───────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=วางค่า Channel Access Token จาก LINE Developers ที่นี่
LINE_CHANNEL_SECRET=วางค่า Channel Secret จาก LINE Developers ที่นี่

# ─── Google Earth Engine ─────────────────────────
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# วิธีได้ค่า GEE_KEY_JSON:
#   1. Download key.json จาก Google Cloud IAM
#   2. รันคำสั่ง: python -c "import json,sys; print(json.dumps(json.load(open('key.json'))))"
#   3. Copy ผลลัพธ์ทั้งบรรทัดวางไว้ด้านล่างนี้
GEE_KEY_JSON={"type":"service_account","project_id":"..."}

# ─── Supabase ────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── LIFF ────────────────────────────────────────
LIFF_URL=https://liff.line.me/YOUR_LIFF_ID

# (Optional) ถ้า frontend อยู่คนละ domain กับ backend ให้ใส่ URL ของ backend
# เช่น API_BASE_URL=https://geoai.up.railway.app
# ถ้าอยู่ domain เดียวกัน ปล่อยว่าง
API_BASE_URL=

# ─── Admin ───────────────────────────────────────
# API key สำหรับ /admin/* endpoints (ปล่อยว่างถ้าเป็น dev mode)
# สร้าง: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# ─── GISTDA Sphere Map ──────────────────────────
# สมัคร API Key ที่ https://sphere.gistda.or.th
SPHERE_KEY=your-sphere-api-key